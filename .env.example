# Copy to .env for local configuration; never commit the resulting file.
# Python/shell commands do not automatically load .env; export variables explicitly.
# The supplied Docker Compose service uses its own SQLite URL and named volume.
DATABASE_URL=sqlite:///data/dominograph.db
# PostgreSQL alternative (configure your own credentials locally):
# Set DATABASE_URL to your local PostgreSQL connection URL.
FRED_API_KEY=
# Host port for Docker Compose (default 8765); shell export examples are in README.
DOMINOGRAPH_PORT=8765
