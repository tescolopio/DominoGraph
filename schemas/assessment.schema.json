{
  "$defs": {
    "DimensionResult": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 100,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "observation_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Observation Ids",
          "type": "array"
        },
        "rules": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Rules",
          "type": "array"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score"
        },
        "uncertainty": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Uncertainty",
          "type": "array"
        }
      },
      "required": [
        "score",
        "confidence",
        "observation_ids",
        "rules",
        "uncertainty"
      ],
      "title": "DimensionResult",
      "type": "object"
    },
    "ReviewStatus": {
      "enum": [
        "unreviewed",
        "pending",
        "approved",
        "rejected",
        "needs_revision"
      ],
      "title": "ReviewStatus",
      "type": "string"
    }
  },
  "$id": "https://dominograph.example/schemas/1.0.0/assessment.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "format": "date",
      "title": "As Of",
      "type": "string"
    },
    "confidence": {
      "maximum": 100,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "dependency": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Dependency"
    },
    "dimensions": {
      "additionalProperties": {
        "$ref": "#/$defs/DimensionResult"
      },
      "title": "Dimensions",
      "type": "object"
    },
    "evidence_ids": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "firebreak": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Firebreak"
    },
    "id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Id",
      "type": "string"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "metric_ids": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "type": "string"
      },
      "title": "Metric Ids",
      "type": "array"
    },
    "node_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Node Id",
      "type": "string"
    },
    "observation_ids": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "type": "string"
      },
      "title": "Observation Ids",
      "type": "array"
    },
    "pressure": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Pressure"
    },
    "relationship_ids": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "type": "string"
      },
      "title": "Relationship Ids",
      "type": "array"
    },
    "review_status": {
      "$ref": "#/$defs/ReviewStatus",
      "default": "unreviewed"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scoring_version": {
      "const": "pilot-weighted-v1",
      "title": "Scoring Version",
      "type": "string"
    },
    "support": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Support"
    },
    "transmission": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Transmission"
    }
  },
  "required": [
    "id",
    "node_id",
    "as_of",
    "scoring_version",
    "dimensions",
    "pressure",
    "firebreak",
    "support",
    "dependency",
    "transmission",
    "metric_ids",
    "observation_ids",
    "relationship_ids",
    "evidence_ids",
    "confidence",
    "limitations"
  ],
  "title": "Assessment",
  "type": "object"
}
