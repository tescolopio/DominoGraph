{
  "$defs": {
    "EvidenceState": {
      "enum": [
        "observed",
        "inferred",
        "correlated",
        "causally_supported",
        "forecast",
        "advocated",
        "policy_proposed",
        "policy_adopted",
        "implemented",
        "documented_coordination",
        "unverified",
        "disputed"
      ],
      "title": "EvidenceState",
      "type": "string"
    },
    "ReviewStatus": {
      "enum": [
        "unreviewed",
        "pending",
        "approved",
        "rejected",
        "needs_revision"
      ],
      "title": "ReviewStatus",
      "type": "string"
    }
  },
  "$id": "https://dominograph.example/schemas/1.0.0/evidence.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "causal_identification": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causal Identification"
    },
    "claim": {
      "minLength": 1,
      "title": "Claim",
      "type": "string"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "evidence_state": {
      "$ref": "#/$defs/EvidenceState"
    },
    "id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "observation",
        "intent"
      ],
      "title": "Kind",
      "type": "string"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "observation_ids": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "type": "string"
      },
      "title": "Observation Ids",
      "type": "array"
    },
    "polarity": {
      "enum": [
        "supporting",
        "contradicting",
        "neutral"
      ],
      "title": "Polarity",
      "type": "string"
    },
    "review_status": {
      "$ref": "#/$defs/ReviewStatus",
      "default": "unreviewed"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Source Id",
      "type": "string"
    },
    "statement_ids": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "type": "string"
      },
      "title": "Statement Ids",
      "type": "array"
    }
  },
  "required": [
    "id",
    "claim",
    "evidence_state",
    "kind",
    "polarity",
    "source_id",
    "observation_ids",
    "statement_ids",
    "confidence",
    "limitations"
  ],
  "title": "Evidence",
  "type": "object"
}
