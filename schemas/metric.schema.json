{
  "$id": "https://dominograph.example/schemas/1.0.0/metric.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baseline": {
      "title": "Baseline",
      "type": "number"
    },
    "context": {
      "minLength": 1,
      "title": "Context",
      "type": "string"
    },
    "contextual_direction": {
      "enum": [
        "higher_is_pressure",
        "lower_is_pressure"
      ],
      "title": "Contextual Direction",
      "type": "string"
    },
    "dataset": {
      "minLength": 1,
      "title": "Dataset",
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "frequency": {
      "enum": [
        "daily",
        "monthly",
        "quarterly",
        "annual"
      ],
      "title": "Frequency",
      "type": "string"
    },
    "id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "node_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Node Id",
      "type": "string"
    },
    "scale": {
      "exclusiveMinimum": 0,
      "title": "Scale",
      "type": "number"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "unit": {
      "minLength": 1,
      "title": "Unit",
      "type": "string"
    }
  },
  "required": [
    "id",
    "node_id",
    "name",
    "dataset",
    "unit",
    "frequency",
    "description",
    "baseline",
    "scale",
    "contextual_direction",
    "context"
  ],
  "title": "Metric",
  "type": "object"
}
