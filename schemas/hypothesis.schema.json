{
  "$defs": {
    "EvidenceState": {
      "enum": [
        "observed",
        "inferred",
        "correlated",
        "causally_supported",
        "forecast",
        "advocated",
        "policy_proposed",
        "policy_adopted",
        "implemented",
        "documented_coordination",
        "unverified",
        "disputed"
      ],
      "title": "EvidenceState",
      "type": "string"
    },
    "ReviewStatus": {
      "enum": [
        "unreviewed",
        "pending",
        "approved",
        "rejected",
        "needs_revision"
      ],
      "title": "ReviewStatus",
      "type": "string"
    }
  },
  "$id": "https://dominograph.example/schemas/1.0.0/hypothesis.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "contradicting_evidence_ids": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "type": "string"
      },
      "title": "Contradicting Evidence Ids",
      "type": "array"
    },
    "dataset_ids": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Dataset Ids",
      "type": "array"
    },
    "evidence_gaps": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Evidence Gaps",
      "type": "array"
    },
    "evidence_state": {
      "$ref": "#/$defs/EvidenceState"
    },
    "falsification_criteria": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Falsification Criteria",
      "type": "array"
    },
    "falsification_status": {
      "enum": [
        "untested",
        "not_falsified",
        "falsified",
        "inconclusive"
      ],
      "title": "Falsification Status",
      "type": "string"
    },
    "id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Id",
      "type": "string"
    },
    "institutional_statement_ids": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "type": "string"
      },
      "title": "Institutional Statement Ids",
      "type": "array"
    },
    "node_ids": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Node Ids",
      "type": "array"
    },
    "policy_ids": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "type": "string"
      },
      "title": "Policy Ids",
      "type": "array"
    },
    "relationship_ids": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "type": "string"
      },
      "title": "Relationship Ids",
      "type": "array"
    },
    "review_status": {
      "$ref": "#/$defs/ReviewStatus",
      "default": "unreviewed"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "statement": {
      "minLength": 1,
      "title": "Statement",
      "type": "string"
    },
    "supporting_evidence_ids": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "type": "string"
      },
      "title": "Supporting Evidence Ids",
      "type": "array"
    }
  },
  "required": [
    "id",
    "statement",
    "node_ids",
    "relationship_ids",
    "dataset_ids",
    "policy_ids",
    "institutional_statement_ids",
    "supporting_evidence_ids",
    "contradicting_evidence_ids",
    "evidence_gaps",
    "falsification_criteria",
    "falsification_status",
    "confidence",
    "evidence_state"
  ],
  "title": "Hypothesis",
  "type": "object"
}
